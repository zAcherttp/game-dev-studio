{
  "name": "@gds/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "game-dev-studio": "./bin/game-dev-studio"
  },
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@gds/adapter-roblox": "workspace:*",
    "@gds/capability": "workspace:*",
    "@gds/core": "workspace:*",
    "@gds/devtools": "workspace:*",
    "@gds/model": "workspace:*",
    "@gds/store": "workspace:*",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
