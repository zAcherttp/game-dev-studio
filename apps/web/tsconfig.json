{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts", "stylex.ts"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/http/FetchHttpClient",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcClientError",
          "effect/rpc/RpcSerialization"
        ]
      }
    ],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vite/client"]
  }
}
