# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# The game checkout the dev studio reads studios from and writes picks into.
# Unset leaves every game-backed capability unavailable.
# @type=string
# @sensitive=false
GDS_GAME=

# CI sets the exact PR base commit for the Landmines budget comparison.
# @type=string
# @sensitive=false
LANDMINES_BASE=

# Set by portless when `pnpm dev` runs the web app (http://game-dev-studio.localhost:1355).
# @type=url
# @sensitive=false
PORTLESS_URL=
