# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# The game checkout the dev studio reads studios from and writes picks into.
# Unset leaves every game-backed capability unavailable.
# @type=string
# @sensitive=false
GDS_GAME=

# The game's own pages the hub lists beside its studios and opens in a frame,
# as a JSON list of { id, title, url, hint? }. The game's scripts/devstudio.sh
# passes tools/devstudio/pages.json. Unset lists none.
# @type=string
# @sensitive=false
GDS_PAGES=

# Where the Foldkit board runs, for the Effect UI studio's links to it until
# the board moves into apps/studio. Unset links to /studio/<id> on the same host.
# @type=string
# @sensitive=false
GDS_BOARD_URL=

# The EasyVFX checkout the Roblox adapter exports kits and draws with.
# Unset uses the game's own tools/easyvfx submodule.
# @type=string
# @sensitive=false
GDS_EASYVFX=

# More folders holding kits/*.luau and sheets/*.json, separated by ";", read
# beside the game's art/vfx/easyvfx, such as a branch's checkout of a kit
# that has not reached the game's live branch yet.
# @type=string
# @sensitive=false
GDS_KITS=

# The Python that runs EasyVFX's renderer and the VFX lab check; it needs
# numpy and Pillow (tools/easyvfx/tools/evfx/requirements.txt).
# @type=string
# @sensitive=false
GDS_PYTHON=python

# Frame workers in the evfx render pool.
# @type=number
# @sensitive=false
GDS_EVFX_WORKERS=4

# ROR_REE from the game's scripts/ror-ree.sh. Set it to let a studio whose
# renderer is roblox.ror draw with ror; unset leaves that renderer off.
# @type=string
# @sensitive=false
GDS_ROR_REE=

# Seconds a studio command (the commands and gates a studio file names)
# may run before the command adapter stops it.
# @type=number
# @sensitive=false
GDS_COMMAND_TIMEOUT_S=300

# The Roblox Studio slot the VFX lab check opens (scripts/studio-slot
# --slot). Unset lets studio-slot choose.
# @type=string
# @sensitive=false
GDS_STUDIO_SLOT=

# Where `pnpm --filter @gds/cli cli serve --port 4310` answers. The web app
# loads the board from it and proxies the browser's /rpc calls to it.
# @type=url
# @sensitive=false
GDS_STUDIO_URL=http://127.0.0.1:4310

# CI sets the exact PR base commit for the Landmines budget comparison.
# @type=string
# @sensitive=false
LANDMINES_BASE=

# Set by portless when `pnpm dev` runs the web app (http://game-dev-studio.localhost:1355).
# @type=url
# @sensitive=false
PORTLESS_URL=
